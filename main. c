#include <stdio.h>

int main() {
    float m1, m2, m3, total, average;

    printf("Enter marks for Subject 1: ");
    scanf("%f", &m1);

    printf("Enter marks for Subject 2: ");
    scanf("%f", &m2);

    printf("Enter marks for Subject 3: ");
    scanf("%f", &m3);

    total = m1 + m2 + m3;
    average = total / 3;

    printf("\nTotal Marks = %.2f", total);
    printf("\nAverage Marks = %.2f\n", average);

    return 0;
}